# Browser-safe Supabase values used for email/password authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Server-only value for authenticated document metadata operations.
SUPABASE_SECRET_KEY=
# A legacy service-role JWT can be used instead if needed.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=

APP_ENV=development
MAX_UPLOAD_MB=10

# Optional: a descriptive name and real contact email for SEC EDGAR requests.
SEC_USER_AGENT=

# Optional server-only key for on-demand explanations.
GROQ_API_KEY=
